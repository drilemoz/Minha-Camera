<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="16dp" android:orientation="vertical">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/camera_form_login_section"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorPrimary" android:accessibilityHeading="true" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MinhaCamera.FormField" android:layout_marginTop="8dp"
        android:hint="@string/usuario">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etUser" style="@style/Widget.MinhaCamera.FormInput"
            android:inputType="text|textNoSuggestions" android:text="admin" android:imeOptions="actionNext" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MinhaCamera.FormField" android:layout_marginTop="8dp"
        android:hint="@string/senha" app:endIconMode="password_toggle">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPass" style="@style/Widget.MinhaCamera.FormInput"
            android:inputType="textPassword" android:imeOptions="actionDone" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="end" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCopyPass"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/copiar_senha" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPastePass"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/colar_senha" />
    </LinearLayout>
</LinearLayout>
